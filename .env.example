# Copy to .env and edit. .env is git-ignored. Never commit real keys.
# Every value has a safe default, so you can run the whole repo with no .env at all.

# Which model answers questions: fake (default, offline, free) | openai | anthropic
LLM_PROVIDER=fake

# Fake LLM personality, for practising failure investigation (article 07):
#   faithful        answers only from retrieved context (default)
#   hallucinate     adds unsupported claims and never refuses
#   ignore_context  ignores the documents entirely
FAKE_LLM_BEHAVIOR=faithful

# Retrieval: how many chunks are sent to the model
RETRIEVER_TOP_K=3

# Optional: write one JSON trace per request (guard, retrieve, sanitize, generate)
# TRACE_FILE=traces/traces.jsonl

# Real providers (only needed when LLM_PROVIDER is openai or anthropic)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# LLM_TIMEOUT_SECONDS=30

# Optional tracing platforms (article 05). Not required by any test.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
